<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f7f2e9">
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="Emilly Carmo, psicóloga. Psicoterapia analítica junguiana para jovens e adultos. Atendimentos online e presenciais.">
<title>Emilly Carmo — Um espaço para se encontrar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--cream:#f7f2e9;--ivory:#fffdf8;--ice:#d5e5ee;--blue:#a8c6da;--blue-dark:#344958;--ink:#333d40;--muted:#6f7774;--gold:#b89359;--gold-light:#e5cc91;--paper:#eee8db;--line:rgba(52,73,88,.16);--serif:'Cormorant Garamond','Noto Serif Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:clip}
body{margin:0;background:var(--cream);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip}
body.menu-open{overflow:hidden}
a{color:inherit;text-decoration:none}
button{font:inherit}
img,video{display:block;max-width:100%;height:auto}
::selection{background:#bed8e9;color:#2f4453}

.container{width:100%;max-width:1240px;margin-inline:auto;padding-inline:clamp(28px,4vw,52px)}
.eyebrow{font-size:10px;line-height:1.6;text-transform:uppercase;letter-spacing:.23em;font-weight:700;color:var(--gold)}
.eyebrow.dark{color:#687b86}
.serif{font-family:var(--serif)}
.italic{font-style:italic}
.section-pad{padding-block:clamp(52px,3.2vw,64px)}
.section-title{font:400 clamp(46px,.25vw + 43px,50px)/1.08 var(--serif);letter-spacing:-.035em;margin:20px 0 22px;color:var(--blue-dark)}
.section-title em{font-style:italic;font-weight:400;color:#aa8249}
p{line-height:1.85}
.small{font-size:13px;line-height:1.7}
.pill{display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:50px;border:1px solid transparent;border-radius:99px;background:var(--blue-dark);color:white;font-size:11px;font-weight:700;letter-spacing:.09em;padding:15px 25px;transition:background .25s,transform .25s,box-shadow .25s;text-transform:uppercase}
.pill:hover{background:#526c79;transform:translateY(-3px);box-shadow:0 10px 26px #213f4b25}
.pill.light{background:var(--cream);color:var(--blue-dark)}
.pill.light:hover{background:#fff}
.text-link{display:inline-flex;align-items:center;gap:10px;border-bottom:1px solid currentColor;padding-bottom:7px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.12em}
.arrow{font-size:17px;transition:transform .25s}
.text-link:hover .arrow,.pill:hover .arrow{transform:translate(3px,-2px)}

.notice{display:none;background:#edf1ee;color:#71807c;font-size:10px;text-align:center;padding:7px 15px;letter-spacing:.06em}
.nav{position:relative;z-index:20;background:var(--cream)}
.nav-inner{min-height:72px;height:72px;display:flex;align-items:center;justify-content:space-between;gap:clamp(8px,1.2vw,20px);min-width:0}
.logo{display:flex;align-items:center;line-height:1;min-width:0;width:184px;max-width:184px;flex-shrink:0}
.logo img{display:block;width:100%;height:auto}
.logo-name{font:500 31px/.92 var(--serif);letter-spacing:-.04em;color:var(--blue-dark)}
.logo-sub{margin:9px 0 0 3px;font:600 9px var(--sans);letter-spacing:.34em;color:#8797a0}
.nav-links{display:flex;align-items:center;flex-wrap:nowrap;gap:clamp(8px,1vw,18px);min-width:0;flex:1;justify-content:center}
.nav-links a{font-size:10px;letter-spacing:.11em;text-transform:uppercase;font-weight:700;color:#596267;transition:color .2s;white-space:nowrap}
.nav-links a:hover{color:var(--gold)}
.nav .pill{min-height:39px;padding:11px 16px;font-size:9px;flex-shrink:0;white-space:nowrap}
.menu-toggle{display:none;border:0;background:transparent;color:var(--blue-dark);font-size:28px;cursor:pointer;padding:8px;font-family:Arial,sans-serif;font-variant-emoji:text}

.hero{background:var(--ice);position:relative;overflow:hidden;isolation:isolate}
.hero:before{position:absolute;content:'';z-index:-1;inset:0;background:radial-gradient(ellipse at 90% 8%,#fbf8ee7a,transparent 48%),radial-gradient(ellipse at -5% 94%,#fffdfa8c,transparent 50%)}
.hero-inner{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,400px);gap:clamp(24px,2.4vw,40px);align-items:center;padding-block:clamp(22px,3vh,40px);min-height:0}
.hero-copy{position:relative;z-index:4;padding-block:4px;min-width:0}
.hero-h1{font:400 clamp(52px,.25vw + 49px,56px)/.92 var(--serif);letter-spacing:-.05em;color:var(--blue-dark);max-width:min(100%,12.4em);margin:14px 0 16px}
.hero-h1 em{font-style:italic;color:#9b783e}
.home-title-break{display:none}
@media (min-width:761px){
.home-title-break{display:inline}
}

.hero-desc{max-width:34em;font-size:15px;line-height:1.75;color:#536978;margin-bottom:24px}
.hero-actions{display:flex;align-items:center;gap:28px;flex-wrap:wrap}
.hero-note{display:flex;align-items:center;gap:12px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:#67818d;margin-top:28px}
.hero-note .line{height:1px;width:42px;background:#8eaaa9;flex:none}
.hero-art{position:relative;width:100%;max-width:400px;aspect-ratio:4/5;min-height:0;justify-self:end;overflow:visible}
.hero-image-wrap{position:absolute;top:10px;right:4%;bottom:58px;width:76%;border-radius:49% 49% 3px 3px;overflow:hidden;box-shadow:18px 24px 0 -10px #f3e7ce;background:#bc9b7b}
.hero-image-wrap img{width:100%;height:100%;object-fit:cover;object-position:51% 50%;filter:saturate(.74) contrast(.94) sepia(.09)}
.hero-image-wrap:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#d9e5ea11 32%,#c9c1a522 100%)}
.hero-floating{position:absolute;z-index:5;bottom:6px;left:0;width:min(72%,228px);padding:16px 18px;background:var(--cream);box-shadow:0 12px 42px #324c5d22;transform:rotate(-5deg)}
.hero-floating span{display:block;font:italic clamp(20px,.25vw + 18px,24px)/.98 var(--serif);color:var(--blue-dark)}
.hero-floating small{display:block;margin-top:10px;color:#8b7a65;font-size:9px;text-transform:uppercase;letter-spacing:.17em}
.hero-art .sunburst{position:absolute;display:block;width:64px;height:64px;top:-2px;right:0;z-index:8;color:#D6AE59;font-size:0;line-height:0;pointer-events:none}
.hero-art .sunburst svg{display:block;width:100%;height:100%;max-width:100%;max-height:100%;fill:none;stroke:currentColor}
.hand-line{position:absolute;left:3%;top:20px;width:90px;height:140px;border:1px solid #a8a08d80;border-radius:50%;transform:rotate(36deg);pointer-events:none}
.hand-line:after{content:'';position:absolute;width:90px;height:140px;border:1px solid #a8a08d80;border-radius:50%;transform:translate(-21px,13px)}
.vertical-words{position:absolute;right:-8px;bottom:75px;transform:rotate(-90deg);transform-origin:right bottom;font-size:9px;letter-spacing:.27em;text-transform:uppercase;font-weight:700;color:#728f98;white-space:nowrap}

.quote-strip{background:var(--ivory);padding:clamp(24px,2.4vw,38px) 20px;text-align:center;border-bottom:1px solid #c5d1d2a6}
.quote-strip p{margin:0 auto;max-width:52em;color:#697479;font:italic clamp(22px,.3vw + 20px,26px)/1.3 var(--serif)}
.quote-strip strong{font-weight:500;color:var(--gold)}

.about{background:var(--cream)}
.about-inner{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(32px,5vw,72px);align-items:center}
.about-visual{position:relative;width:100%;max-width:420px;aspect-ratio:4/5;min-height:0;justify-self:center}
.about-photo{position:absolute;width:81%;height:86%;top:12px;left:5%;overflow:hidden;background:#e0d8c5;border-radius:3px 150px 3px 3px}
.about-photo img{height:100%;width:100%;object-fit:cover;object-position:50% 45%;filter:saturate(.75) sepia(.08) contrast(.96)}
.about-photo:after{content:'';position:absolute;inset:0;background:linear-gradient(120deg,#efe5cd00,#e6cead24)}
.about-visual:before{content:'';position:absolute;inset:0 8% auto auto;border:1px solid #b5a887;width:77%;height:84%;transform:translate(16px,12px)}
.about-mini{position:absolute;z-index:2;right:0;bottom:0;width:38%;max-width:170px;aspect-ratio:190/220;overflow:hidden;border:8px solid var(--cream);box-shadow:0 12px 35px #242c2f12;background:#e0d8c5}
.about-mini img{height:100%;width:100%;object-fit:cover}
.about-copy{max-width:540px;min-width:0}
.about-copy p{color:#586364;font-size:15px;margin:0 0 18px}
.about-quote{border-left:2px solid var(--gold);padding:8px 0 8px 22px;margin:28px 0;color:#92794c;font:italic clamp(22px,.2vw + 20px,24px)/1.15 var(--serif)}

.reasons{background:#fbf9f4}
.reasons-head{text-align:center;max-width:740px;margin:0 auto 44px}
.reasons-head .section-title{margin-bottom:16px}
.reasons-head p{color:#68716d;font-size:14px;max-width:570px;margin:0 auto}
.reason-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,1.2vw,18px)}
.reason{position:relative;min-height:0;background:#f4f1e9;padding:32px 28px 26px;display:flex;flex-direction:column;align-items:flex-start;border:1px solid #eee8dc;transition:transform .4s,background .4s,border-color .4s}
.reason:hover{background:#e7edf0;transform:translateY(-5px);border-color:#b9cbd6}
.reason-num{color:#b89963;font:italic 24px/1 var(--serif);margin-bottom:auto}
.reason-icon{position:absolute;top:32px;right:28px;display:block;width:33px;height:33px;line-height:0;color:#bcb2a0}
.reason-icon svg{display:block;width:100%;height:100%;max-width:100%;max-height:100%;stroke:currentColor}
.reason h3{color:var(--blue-dark);font:500 clamp(28px,.2vw + 26px,30px)/1.08 var(--serif);letter-spacing:-.015em;margin:28px 0 10px}
.reason p{font-size:13px;line-height:1.7;color:#64706e;margin:0}
.reason-footer{text-align:center;margin-top:44px}
.reason-footer p{font:italic clamp(22px,.25vw + 18px,26px)/1.25 var(--serif);color:#8f805f;margin:0 0 24px}

.approach{background:var(--blue);position:relative;overflow:hidden}
.approach:before{content:'\2733\FE0E';position:absolute;color:#ffffff60;font:400 clamp(180px,16vw,280px)/.8 var(--serif);right:-70px;top:-90px;pointer-events:none}
.approach-inner{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(36px,5vw,72px)}
.approach .section-title{color:#2d4859}
.approach .section-title em{color:#fbf1dc}
.approach-copy{margin-top:28px;color:#375464;max-width:490px;font-size:15px}
.approach-side{align-self:end;display:flex;flex-direction:column;gap:8px;padding-bottom:8px}
.approach-chip{border-top:1px solid #648da45c;padding:18px 0;display:flex;gap:24px;align-items:flex-start}
.approach-chip b{color:#f8f3e7;font:italic clamp(26px,.2vw + 24px,28px)/.95 var(--serif);min-width:46px;flex:none}
.approach-chip p{font-size:13px;color:#426075;line-height:1.65;margin:0}
.approach-chip strong{display:block;margin-bottom:5px;color:#2f4858;font-size:12px;letter-spacing:.12em;text-transform:uppercase}

.sessions{background:var(--cream)}
.sessions-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:36px}
.sessions-head .section-title{max-width:16ch;margin-bottom:0}
.sessions-head p{font-size:13px;color:#67716e;max-width:330px;flex:none}
.session-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,1.5vw,22px)}
.session{min-height:0;padding:clamp(28px,2.6vw,44px);display:flex;flex-direction:column;position:relative;overflow:hidden}
.session.online{background:#e4e9e6}
.session.presencial{background:#e8dbc0}
.session:after{content:'';position:absolute;width:230px;height:230px;right:-80px;bottom:-105px;border:1px solid #9fb1ad8a;border-radius:50%;box-shadow:0 0 0 22px #ffffff14,0 0 0 44px #ffffff21;pointer-events:none}
.session-number{font-size:10px;letter-spacing:.2em;font-weight:700;color:#7b8b89}
.session h3{font:400 clamp(42px,.3vw + 40px,46px)/1.05 var(--serif);letter-spacing:-.025em;color:var(--blue-dark);margin:28px 0 12px}
.session p{max-width:360px;font-size:14px;color:#69716c;margin:0 0 25px}
.session-foot{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #ffffffa8;padding-top:22px;margin-top:auto;color:#5e6d6d;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.sessions-note{margin-top:21px;color:#73807c;font-size:11px;text-align:right}
.session.presencial .session-portrait{position:absolute;top:24px;right:28px;width:min(184px,38%);height:177px;max-width:40%;object-fit:cover;object-position:50% 12%;border-radius:115px 115px 6px 6px;z-index:0;pointer-events:none;filter:saturate(.89);-webkit-mask-image:linear-gradient(to bottom,#000 82%,transparent 100%);mask-image:linear-gradient(to bottom,#000 82%,transparent 100%)}
.session.presencial > :not(.session-portrait){position:relative;z-index:1}

.letter{background:var(--ivory);overflow:hidden}
.letter-inner{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(36px,5vw,72px);align-items:center}
.letter-preview{position:relative;overflow:hidden;background:#d3b996;border-radius:3px;width:min(100%,360px);height:auto;aspect-ratio:9/16;justify-self:center}
.letter-preview video{display:block;width:100%;height:100%;aspect-ratio:9/16;object-fit:cover;background:#dbcdb8}
.letter-preview:after{content:'';inset:0;position:absolute;background:linear-gradient(to top,#213340b0,transparent 55%);pointer-events:none;display:none}
.letter-overlay{position:absolute;inset:auto 35px 36px;color:white;z-index:2}
.letter-overlay span{font:italic 40px/.95 var(--serif);display:block;max-width:330px}
.letter-overlay small{display:block;margin-top:15px;letter-spacing:.14em;text-transform:uppercase;font-size:10px}
.letter-stamp{position:absolute;z-index:3;top:21px;left:22px;padding:10px 14px;background:#fff9edee;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#746b55;font-weight:700}
.letter-copy .section-title{margin-top:20px}
.letter-copy p{font-size:15px;color:#626c68;max-width:435px}
.letter-coming{display:flex;gap:13px;align-items:center;margin-top:27px;color:#9b835e;font-size:12px;line-height:1.5;border:0;background:none;padding:0;cursor:pointer;text-align:left}
.letter-coming:hover .letter-circle{background:#f5efe5}
.letter-circle{width:43px;height:43px;border:1px solid #ad9b80;border-radius:50%;display:grid;place-items:center;font-size:14px;flex:none}

.steps{background:#eef1ef}
.steps-head{text-align:center;max-width:620px;margin:0 auto 40px}
.steps-head p{font-size:14px;color:#657372}
.step-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,1.6vw,24px)}
.step{padding:28px 16px 20px;border-top:1px solid #9faeaf;position:relative;min-width:0}
.step-num{font:italic clamp(36px,.25vw + 34px,40px)/1 var(--serif);color:#ae956a}
.step h3{font:500 clamp(28px,.2vw + 26px,30px)/1.15 var(--serif);color:var(--blue-dark);margin:24px 0 14px}
.step p{font-size:13px;line-height:1.75;color:#677374;margin:0;max-width:300px}

.faq{background:var(--cream)}
.faq-inner{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:clamp(36px,4.5vw,64px)}
.faq-intro p{font-size:14px;color:#66716f}
.faq-list{border-top:1px solid var(--line)}
details{border-bottom:1px solid var(--line);padding:22px 0}
summary{display:flex;align-items:center;justify-content:space-between;gap:25px;list-style:none;cursor:pointer;color:var(--blue-dark);font-size:15px;font-weight:600;line-height:1.4}
summary::-webkit-details-marker{display:none}
summary::after{content:'+';font-size:27px;font-weight:300;color:var(--gold);transition:transform .25s;flex:none}
details[open] summary:after{transform:rotate(45deg)}
details p{font-size:13px;line-height:1.9;color:#687472;margin:16px 55px 1px 0}

.contact{background:#394f5b;position:relative;overflow:hidden;color:#f8f2e7}
.contact:before{content:'\2733\FE0E';position:absolute;left:-55px;bottom:-90px;color:#c6d8e618;font:400 clamp(160px,18vw,260px)/1 var(--serif);pointer-events:none}
.contact-inner{text-align:center;position:relative;z-index:1;max-width:820px;margin-inline:auto}
.contact .eyebrow{color:#e9c890}
.contact h2{font:400 clamp(46px,.35vw + 42px,52px)/.94 var(--serif);letter-spacing:-.04em;margin:22px auto;color:#fff9ed}
.contact h2 em{font-style:italic;color:#d7bb85}
.contact p{font-size:14px;color:#d4dddf;max-width:490px;margin:0 auto 30px}
.contact .contact-pending{color:#cdd3d1;font-size:11px;margin-top:17px}
.contact .contact-pending a{text-decoration:underline}
.contact-direct{display:flex;justify-content:center;align-items:center;gap:11px 26px;flex-wrap:wrap;margin:27px auto 0;max-width:790px;font-size:12px;color:#f4eada}
.contact-direct a{color:#fff7e9;border-bottom:1px solid rgba(246,237,218,.55);padding-bottom:3px;text-decoration:none;transition:border-color .2s}
.contact-direct a:hover{border-color:#fff}
.contact-direct span{white-space:nowrap}

.footer{background:#f7f2e9;padding:43px 0}
.footer-inner{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr) minmax(0,1fr);align-items:end;gap:20px}
.footer .logo{max-width:260px;width:100%}
.footer .logo-name{font-size:30px}
.footer p{color:#71807b;font-size:11px;line-height:1.7;margin:9px 0 0}
.footer small{color:#7d8b86;font-size:10px;line-height:1.8;display:block}
.footer .right{text-align:right}
.footer small a{color:#516d79;text-decoration:underline;text-decoration-color:#9bb1b7;text-underline-offset:3px}

.reveal{opacity:0;transform:translateY(28px);transition:opacity .75s ease,transform .75s ease}
.reveal.in{opacity:1;transform:translateY(0)}
.reason:nth-child(2),.step:nth-child(2){transition-delay:.08s}
.reason:nth-child(3),.step:nth-child(3){transition-delay:.16s}
.reason:nth-child(4){transition-delay:.08s}
.reason:nth-child(5){transition-delay:.16s}
.reason:nth-child(6){transition-delay:.24s}

.arrow svg{display:inline-block;width:17px;height:17px;vertical-align:middle;stroke:currentColor}
.session-foot svg{display:inline-block;width:19px;height:19px;color:#5e6d6d;vertical-align:middle}
.contact-direct svg{display:inline-block;width:13px;height:13px;vertical-align:middle}
.letter-circle svg{display:block;width:46%;height:46%;margin:auto}

@keyframes heroRise{from{opacity:0;transform:translateY(34px);filter:blur(8px)}to{opacity:1;transform:none;filter:blur(0)}}
@keyframes heroFade{from{opacity:0}to{opacity:1}}
@keyframes heroLine{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@media (prefers-reduced-motion:no-preference){
.hero-copy>.eyebrow,.hero-h1,.hero-desc,.hero-actions,.hero-note{opacity:0;animation:heroRise 1.1s cubic-bezier(.2,.7,.2,1) forwards}
.hero-copy>.eyebrow{animation-delay:.15s}
.hero-h1{animation-delay:.35s;animation-duration:1.4s}
.hero-desc{animation-delay:.85s}
.hero-actions{animation-delay:1.05s}
.hero-note{animation-delay:1.3s}
.hero-note .line{transform-origin:left;animation:heroLine 1s ease 1.5s both}
.hero-floating span,.hero-floating small{opacity:0;animation:heroRise 1.1s cubic-bezier(.2,.7,.2,1) forwards}
.hero-floating span{animation-delay:1.2s}
.hero-floating small{animation-delay:1.5s}
.vertical-words{opacity:0;animation:heroFade 1.6s ease 1.6s forwards}
}
@media (prefers-reduced-motion:reduce){
html{scroll-behavior:auto}
.reveal{opacity:1;transform:none;transition:none}
.pill,.reason,.arrow{transition:none}
}

@media (max-width:1180px){
.nav .pill{display:none}
.nav-links{gap:clamp(10px,1.1vw,18px);justify-content:flex-end}
}

@media (max-height:820px) and (min-width:761px){
.hero-inner{padding-block:16px;gap:24px}
.hero-image-wrap{bottom:50px}
.hero-h1{margin:10px 0 12px}
.hero-desc{margin-bottom:16px}
.hero-note{margin-top:16px}
.hero-copy{padding-block:0}
.hero-floating{bottom:4px;padding:14px 16px}
}
@media (max-width:1050px){
.hero-inner{gap:22px;padding-block:24px;grid-template-columns:minmax(0,1fr) minmax(240px,360px)}
.hero-art{max-width:360px;justify-self:end}
.about-inner,.approach-inner,.letter-inner{gap:36px}
}

@media (max-width:900px){
.reason-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.sessions-head{flex-wrap:wrap;align-items:flex-start}
